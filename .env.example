# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/assurances_biat
PGVECTOR_ENABLED=true

# Auth
JWT_SECRET=changeme_secure_secret_key_here
JWT_EXPIRES_IN=3600
ENABLE_SSO=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
SIMILARITY_THRESHOLD=0.7
TOP_K_RESULTS=5

# LLM
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# LLM Performance Settings
# Number of CPU threads to use for inference (increase for faster CPU processing)
LLM_NUM_THREADS=6

# GPU Configuration
# Number of GPU layers to offload (0 = CPU only, higher = more GPU usage)
LLM_GPU_LAYERS=0

# GPU device to use (0 = first GPU, -1 = CPU only, can specify multiple: "0,1")
LLM_GPU_DEVICE=0

# Context window size (max tokens for context)
LLM_CONTEXT_SIZE=2048

# Logging
LOG_LEVEL=debug

# Frontend (built by Nest)
FRONTEND_BUILD_PATH=./frontend/dist

# CORS (for development)
CORS_ORIGIN=http://localhost:5173

# Email Configuration (SMTP)
# For Gmail, use smtp.gmail.com with App Password (not regular password)
# See setup guide in README for how to get Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Application URLs
# Backend API URL
APP_URL=http://localhost:3000
# Frontend URL (used in email links for verification/password reset)
FRONTEND_URL=http://localhost:5173